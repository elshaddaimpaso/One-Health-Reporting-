# Copy to .env for local development (never commit .env)
# Supabase: Connect -> Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# At least 12 characters. Use a long random one.
ADMIN_PASSWORD=
# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=
